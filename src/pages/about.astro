---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Buttons from '../components/Buttons.astro';
import { pageNote, sitePhoto } from '../lib/site';

const { data: d, Content } = await pageNote('about');
---
<Base title={d.title} description={d.description ?? d.lede ?? d.headline}>
  <section class="about-grid">
    <div class="prose">
      <h1>{d.headline}</h1>
      {d.lede && <p class="lede">{d.lede}</p>}
      <Content />
      {d.evidence && (
        <>
          <h2>How I think, in writing</h2>
          <ul class="evidence">{d.evidence.map((e) => <li><a href={e.url}><span class="label">{e.label}</span><span class="t">{e.title}</span></a></li>)}</ul>
        </>
      )}
      <Buttons links={d.buttons} class="mt" />
    </div>
    <div class="photos">
      {(d.photos ?? []).map((p) => (
        <figure><Image src={sitePhoto(p.image)} alt={p.alt} width={1000} />{p.caption && <figcaption>{p.caption}</figcaption>}</figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .mt { margin-top: .6rem; }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import NewsList from '../components/NewsList.astro';
import Buttons from '../components/Buttons.astro';
import { publishedInsights } from '../lib/insights';
import { pageNote, sitePhoto } from '../lib/site';

const { data: d, Content } = await pageNote('home');
const posts = await publishedInsights();
const latest = posts.slice(0, 3);
const doors = [
  { ...d.consulting!, image: sitePhoto('rfs-radio.jpg'), alt: 'Russell Buzby on the radio in a NSW RFS vehicle', pos: '50% 50%' },
  { ...d.poetry!, image: sitePhoto('words-in-winter.jpg'), alt: 'Russell Buzby reading at the Words in Winter festival', pos: '50% 25%' },
];
---
<Base description={d.description ?? d.lede ?? d.headline}>
  <section class="hero">
    <div class="stack">
      <h1>{d.headline}</h1>
      {d.byline && <p class="byline">{d.byline}</p>}
      {d.lede && <p class="lede measure">{d.lede}</p>}
      <div class="stack measure"><Content /></div>
      <Buttons links={d.buttons} />
    </div>
    <figure>
      <Image src={sitePhoto('poet-headshot.jpg')} alt="Russell Buzby" width={1200} loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <section class="registers" aria-label="Consulting and poetry">
    {doors.map((r) => (
      <div class="register">
        <Image src={r.image} alt={r.alt} width={1000} style={`object-position: ${r.pos};`} />
        <div class="stack">
          <h2>{r.title}</h2>
          <p class="lede">{r.lede}</p>
          <p>{r.text}</p>
          <Buttons links={r.buttons} />
        </div>
      </div>
    ))}
  </section>

  <section>
    <div class="section-head">
      <h2>Latest insights</h2>
      <a class="more" href="/insights/">All {posts.length} articles</a>
    </div>
    <div class="featured">
      {latest.map((e) => <PostCard entry={e} eager />)}
    </div>
  </section>

  <section class="news">
    <div class="section-head">
      <h2>Poetry news</h2>
      <a class="more" href="/poetry/">Poetry</a>
    </div>
    <NewsList limit={4} />
  </section>
</Base>

---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import Buttons from '../components/Buttons.astro';
import { getImage } from 'astro:assets';
import { pageNote, sitePhoto, inline } from '../lib/site';

const { data: d, Content } = await pageNote('poetry');
const poems = (await getCollection('poems')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(poems.map(async (p) => ({ p, Content: (await render(p)).Content })));
const bios = [
  { id: 'bio25', label: 'Bio – 25 words', text: d.bio25 },
  { id: 'bio50', label: 'Bio – 50 words', text: d.bio50 },
  { id: 'bio100', label: 'Bio – 100 words', text: d.bio100 },
].filter((b) => b.text);
const og = d.headshot ? await getImage({ src: sitePhoto(d.headshot.image), width: 1200, height: 630, format: 'jpg' }) : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
const jumps = [['#poems', 'Poems'], ['#news', 'News'], ['#origin', 'Where they come from'], ['#press', 'For editors']];
---
<Base title={d.title} description={d.description ?? d.lede ?? d.headline} image={ogUrl} pageClass="page-poetry">
  <section class="epigraph">
    <div class="stack">
      <h1>{d.headline}</h1>
      {d.lede && <p class="lede measure">{d.lede}</p>}
      <p class="jumps">{jumps.map(([h, l]) => <a href={h}>{l}</a>)}</p>
      {d.epigraph && (
        <blockquote>{d.epigraph}
          {d.epigraph_cite && <cite>{d.epigraph_cite.map((l, i) => <>{i > 0 && <br />}{l}</>)}</cite>}
        </blockquote>
      )}
    </div>
    {d.headshot && (
      <figure>
        <Image src={sitePhoto(d.headshot.image)} alt={d.headshot.alt} width={900} loading="eager" />
      </figure>
    )}
  </section>

  <section id="poems">
    <h2>Published and placed</h2>
    <div class="poems">
      {rendered.map(({ p, Content: Poem }) => (
        <article class="poem">
          <div>
            <h3>{p.data.title}</h3>
            <p class="status">{p.data.status}</p>
            {p.data.detail && <p class="detail">{p.data.detail}</p>}
          </div>
          <div class="stack">
            <Poem />
            <Buttons links={p.data.links} />
          </div>
        </article>
      ))}
    </div>
  </section>

  {d.gallery && d.gallery.length > 0 && (
    <section class="gallery" aria-label="Photographs">
      {d.gallery.map((g) => (
        <figure><Image src={sitePhoto(g.image)} alt={g.alt} width={1000} />{g.caption && <figcaption>{g.caption}</figcaption>}</figure>
      ))}
    </section>
  )}

  <section class="news" id="news">
    <h2>Recent news</h2>
    <NewsList />
  </section>

  <section class="origin" id="origin">
    {d.origin_photo && (
      <figure>
        <Image src={sitePhoto(d.origin_photo.image)} alt={d.origin_photo.alt} width={900} />
        {d.origin_photo.caption && <figcaption>{d.origin_photo.caption}</figcaption>}
      </figure>
    )}
    <div class="prose">
      <Content />
      <Buttons links={d.instagram_buttons} />
    </div>
  </section>

  <section id="press">
    <h2>Bios, photograph, contact</h2>
    <div class="bios">
      {bios.map((b) => (
        <div class="bio">
          <div class="top"><h3>{b.label}</h3><button class="copy" type="button" data-copy={b.id} id={`copy-${b.id}`} aria-live="polite" aria-label={`Copy the ${b.label.toLowerCase()}`}>Copy</button></div>
          <p id={b.id}>{b.text}</p>
        </div>
      ))}
    </div>
    <div class="meta-row">
      {d.photograph_note && <div><h3>Photograph</h3><p set:html={inline(d.photograph_note)} /></div>}
      {d.contact_note && <div><h3>Contact</h3><p set:html={inline(d.contact_note)} /></div>}
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => {
    b.addEventListener('click', () => {
      const t = document.getElementById(b.dataset.copy!)?.textContent ?? '';
      const show = (msg: string) => { b.textContent = msg; setTimeout(() => { b.textContent = 'Copy'; }, 2000); };
      if (navigator.clipboard) navigator.clipboard.writeText(t).then(() => show('Copied'), () => show('Select and copy')); else show('Select and copy');
    });
  });
</script>

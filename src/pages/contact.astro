---
import Base from '../layouts/Base.astro';
import Buttons from '../components/Buttons.astro';
import { pageNote, inline } from '../lib/site';

const { data: d, Content } = await pageNote('contact');
---
<Base title={d.title} description={d.description ?? d.lede ?? d.headline}>
  <section class="contact">
    <div class="stack">
      <h1>{d.headline}</h1>
      {d.lede && <p class="lede measure">{d.lede}</p>}
      <Content />
      <Buttons links={d.buttons} />
    </div>
    {d.details && (
      <dl>
        {d.details.map((x) => (
          <>
            <dt>{x.label}</dt>
            <dd set:html={inline(x.text)} />
          </>
        ))}
      </dl>
    )}
  </section>
</Base>

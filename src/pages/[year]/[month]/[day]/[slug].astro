---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import { splitReferences } from '../../../../lib/refs';
import Base from '../../../../layouts/Base.astro';
import Buttons from '../../../../components/Buttons.astro';
import { publishedInsights, insightParams, insightPath, fmtDate } from '../../../../lib/insights';
import { sitePhoto } from '../../../../lib/site';

export async function getStaticPaths() {
  const posts = await publishedInsights();
  const pages = posts.map((entry, i) => ({
    params: insightParams(entry),
    props: { entry, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null, redirectTo: null as string | null },
  }));
  const aliases = posts.flatMap((entry) =>
    entry.data.aliases.map((alias) => ({
      params: { ...insightParams(entry), slug: alias },
      props: { entry, newer: null, older: null, redirectTo: insightPath(entry) },
    })),
  );
  return [...pages, ...aliases];
}
const { entry, newer, older, redirectTo } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const refs = splitReferences(entry.body ?? '');
const og = await getImage({ src: d.image, width: 1200, height: 630, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
---
{redirectTo ? (
  <html lang="en-AU">
    <head>
      <meta charset="utf-8" />
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
      <link rel="canonical" href={new URL(redirectTo, Astro.site)} />
      <meta name="robots" content="noindex" />
      <title>{d.title}</title>
    </head>
    <body><p>This article has a new address: <a href={redirectTo}>{d.title}</a>.</p></body>
  </html>
) : (
<Base title={d.title} description={d.summary} image={ogUrl} type="article">
  <article class="article">
    <header class="article-head">
      <p class="log">
        <time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date)}</time>
        <span class="sep">·</span>{d.themes.join(' · ')}
      </p>
      <h1>{d.title}</h1>
      <p class="byline">Russell Buzby · Braidwood, New South Wales</p>
    </header>
    <figure class="article-hero">
      <Image src={d.image} alt={d.imageAlt ?? ''} width={1600} height={800} widths={[480, 800, 1200, 1600]} sizes="(max-width: 1120px) 100vw, 1120px" loading="eager" fetchpriority="high" />
      {d.imageCredit && <figcaption>{d.imageCredit}</figcaption>}
    </figure>
    <div class="article-body" id="body">
      <Content />
    </div>
    <div class="share" data-url={new URL(insightPath(entry), Astro.site).href} data-title={d.title}>
      <span class="label">Share</span>
      <button class="chip" type="button" id="copy-link">Copy link</button>
      <a class="chip" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(new URL(insightPath(entry), Astro.site).href)}`} target="_blank" rel="noopener">LinkedIn<span class="sr">, opens in a new tab</span></a>
      <a class="chip" href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(new URL(insightPath(entry), Astro.site).href)}`}>Email</a>
      <button class="chip" type="button" id="share-native" hidden>Share…</button>
    </div>
    <aside class="author" aria-label="About the author">
      <Image src={sitePhoto('poet-headshot.jpg')} alt="Russell Buzby" width={192} height={192} />
      <div class="stack">
        <p class="name">Russell Buzby</p>
        <p>Senior Manager at Parbery Consulting, advising Commonwealth leaders on complex reform. Captain in the NSW Rural Fire Service at Braidwood, and a poet: ‘Bogong’ won the 2026 Venie Holmgren Environmental Poetry Prize.</p>
        <Buttons links={[{ label: 'All insights', url: '/insights/' }, { label: 'About', url: '/about/' }, { label: 'Poetry', url: '/poetry/' }]} />
      </div>
    </aside>
    {refs.length > 0 && (
      <section class="refs" aria-label="References">
        <h2>References</h2>
        <ol>{refs.map((r) => <li set:html={r} />)}</ol>
      </section>
    )}
    <nav class="article-nav" aria-label="More articles">
      {older && <a href={insightPath(older)}><span class="label">Earlier article</span><span class="t">{older.data.title}</span></a>}
      {newer && <a class="later" href={insightPath(newer)}><span class="label">Later article</span><span class="t">{newer.data.title}</span></a>}
    </nav>
  </article>
</Base>
)}

<script>
  const box = document.querySelector<HTMLElement>('.share');
  if (box) {
    const url = box.dataset.url!, title = box.dataset.title!;
    const copy = document.getElementById('copy-link') as HTMLButtonElement;
    const show = (msg: string) => { copy.textContent = msg; setTimeout(() => { copy.textContent = 'Copy link'; }, 2000); };
    copy.addEventListener('click', () => {
      if (navigator.clipboard) navigator.clipboard.writeText(url).then(() => show('Link copied'), () => show('Could not copy'));
      else show('Could not copy');
    });
    const nat = document.getElementById('share-native') as HTMLButtonElement;
    if (navigator.share) { nat.hidden = false; nat.addEventListener('click', () => { navigator.share({ title, url }).catch(() => {}); }); }
  }
</script>

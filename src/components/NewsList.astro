---
import { getCollection, render } from 'astro:content';

interface Props { limit?: number }
const { limit } = Astro.props;
const items = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const shown = limit ? items.slice(0, limit) : items;
const rendered = await Promise.all(shown.map(async (n) => ({ n, Content: (await render(n)).Content })));
const month = (d: Date) => new Intl.DateTimeFormat('en-AU', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d);
---
<ul>
  {rendered.map(({ n, Content }) => (
    <li>
      <p class="log"><time datetime={n.data.date.toISOString().slice(0, 10)}>{month(n.data.date)}</time></p>
      <div class="stack">
        <h3>{n.data.title}</h3>
        <Content />
      </div>
    </li>
  ))}
</ul>

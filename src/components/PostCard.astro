---
import { Image } from 'astro:assets';
import { insightPath, themeSlug, fmtDate, type Insight } from '../lib/insights';

interface Props {
  entry: Insight;
  eager?: boolean;
  clamp?: number; // characters of summary to show; 0 = all
  level?: 2 | 3; // heading level for the title, by where the card sits
}
const { entry, eager = false, clamp = 0, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const href = insightPath(entry);
const d = entry.data;
let summary = d.summary;
if (clamp && summary.length > clamp) summary = summary.slice(0, clamp).replace(/\s+\S*$/, '') + '…';
const cats = d.themes.map(themeSlug).join(' ');
---
<article class="post" data-cats={cats}>
  <a class="post-img" href={href} tabindex="-1" aria-hidden="true">
    <Image src={d.image} alt="" width={640} height={427} loading={eager ? 'eager' : 'lazy'} />
  </a>
  <div class="post-body">
    <p class="log">
      <time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date)}</time>
      <span class="sep">·</span>{d.themes.join(' · ')}
    </p>
    <H class="post-title"><a href={href}>{d.title}</a></H>
    <p class="excerpt">{summary}</p>
  </div>
</article>

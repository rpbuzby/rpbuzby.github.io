---
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  image?: string; // absolute URL for social cards
  type?: 'website' | 'article';
}
const { title, description, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · Russell Buzby` : 'Russell Buzby';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = image ?? new URL('/og-default.jpg', Astro.site).href;

const nav = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/about/', label: 'About', match: (p: string) => p.startsWith('/about') },
  { href: '/insights/', label: 'Insights', match: (p: string) => p.startsWith('/insights') || /^\/\d{4}\//.test(p) },
  { href: '/poetry/', label: 'Poetry', match: (p: string) => p.startsWith('/poetry') },
  { href: '/contact/', label: 'Contact', match: (p: string) => p.startsWith('/contact') },
];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Russell Buzby · Insights" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="Russell Buzby" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="wrap">
      <a class="skip" href="#main">Skip to content</a>
      <header class="mast">
        <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>Russell Buzby</a>
        <nav class="nav" aria-label="Site">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.match(path) ? 'page' : undefined} data-home={n.href === '/' ? '' : undefined}>{n.label}</a>
          ))}
        </nav>
      </header>
      <main class="page" id="main">
        <slot />
      </main>
      <footer>
        <span>Russell Buzby · Braidwood, New South Wales</span>
        <span class="links">
          <a href="mailto:rpbuzby@me.com">Email</a>
          <a href="/rss.xml">RSS feed</a>
          <a href="https://www.linkedin.com/in/russell-buzby/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://www.instagram.com/rpbuzby/" target="_blank" rel="noopener">Instagram</a>
        </span>
      </footer>
    </div>
  </body>
</html>

{
  "userIgnoreFilters": ["node_modules/", "dist/", ".astro/", ".github/", "public/", "scripts/", "src/assets/", "src/components/", "src/layouts/", "src/lib/", "src/styles/", "package.json", "package-lock.json", "astro.config.mjs"],
  "showUnsupportedFiles": false,
